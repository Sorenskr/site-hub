# ===== 必填 =====
# GitHub Personal Access Token（需要勾选 repo 权限）
# 创建地址：https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub 用户名（你的用户名，例如 Sorenskr）
GITHUB_OWNER=Sorenskr

# 仓库名（源代码所在的仓库，例如 site-hub）
GITHUB_REPO=site-hub

# 分支名，默认 main
GITHUB_BRANCH=main

# 后台管理登录密码（自己设置一个强密码）
ADMIN_PASSWORD=change-me-please

# ===== 可选 =====
# 登录会话签名密钥（不填会自动用 ADMIN_PASSWORD 派生）
# ADMIN_SECRET=some-random-string
